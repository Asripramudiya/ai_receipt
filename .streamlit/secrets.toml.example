# Contoh isi Secrets untuk Streamlit Community Cloud.
# JANGAN commit file ini dengan value asli ke GitHub (sudah masuk .gitignore).
#
# Cara pakai di Streamlit Community Cloud:
# 1. Buka app Anda di share.streamlit.io
# 2. Klik menu titik tiga (⋮) -> Settings -> Secrets
# 3. Copy-paste isi di bawah ini, ganti value dengan API key asli Anda
# 4. Save -> aplikasi akan otomatis restart dengan secrets baru

OPENROUTER_API_KEY = "sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_MODEL = "openai/gpt-4o-mini"
